    "IPv6 is the newer internet address format. Many home networks still work fine on IPv4 only. This is informational and does not mean your connection is unsafe." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "IPv6 es el formato de dirección más reciente. Muchas redes domésticas siguen funcionando bien solo con IPv4. Esto es informativo y no significa que tu conexión sea insegura."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "IPv6は新しいインターネットアドレス形式です。多くの自宅ネットワークはIPv4のみでも問題なく動作します。情報提供であり、接続が危険という意味ではありません。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "IPv6 é o formato mais novo de endereço da internet. Muitas redes domésticas ainda funcionam bem só com IPv4. Isto é informativo e não significa que sua conexão seja insegura."
          }
        }
      }
    },
