    "Your device is using cellular data instead of Wi-Fi. Privacy risks are usually lower than on public hotspots, but a VPN still hides your traffic from the carrier." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu dispositivo usa datos móviles en lugar de Wi-Fi. El riesgo de privacidad suele ser menor que en un hotspot público, pero una VPN sigue ocultando tu tráfico al operador."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "デバイスはWi-Fiではなくモバイルデータ通信を使用しています。プライバシーリスクは公共ホットスポットより低いことが多いですが、VPNを使えば通信事業者からもトラフィックを隠せます。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seu dispositivo está usando dados móveis em vez de Wi-Fi. Os riscos de privacidade costumam ser menores do que em hotspots públicos, mas uma VPN ainda oculta seu tráfego da operadora."
          }
        }
      }
    },
