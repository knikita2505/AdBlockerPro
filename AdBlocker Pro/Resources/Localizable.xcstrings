    "iOS reports that there is no satisfied network path. Turn on Wi-Fi or cellular data and scan again. Airplane Mode will also cause this result." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iOS indica que no hay una ruta de red válida. Activa Wi-Fi o datos móviles y vuelve a escanear. El modo Avión también provoca este resultado."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iOSは有効なネットワーク経路がないと報告しています。Wi-Fiまたはモバイルデータ通信をオンにして再スキャンしてください。機内モードでもこの結果になります。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O iOS informa que não há um caminho de rede válido. Ative o Wi-Fi ou os dados móveis e escaneie de novo. O Modo Avião também causa este resultado."
          }
        }
      }
    },
    "IPv6 is not available on this network" : {
      "comment" : "Description of a privacy check indicating that the user's network does not support IPv6.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
