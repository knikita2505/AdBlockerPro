    },
    "DNS turns names like apple.com into IP addresses. This check only verifies that lookup works on the current network. iOS does not let apps see whether DNS is encrypted (iCloud Private Relay or DNS over HTTPS)." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El DNS convierte nombres como apple.com en direcciones IP. Esta comprobación solo verifica que la resolución funciona en la red actual. iOS no permite a las apps ver si el DNS está cifrado (iCloud Private Relay o DNS sobre HTTPS)."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "DNSはapple.comのような名前をIPアドレスに変換します。このチェックは、現在のネットワークで名前解決ができることだけを確認します。iOSはDNSが暗号化されているか（iCloudプライベートリレーやDNS over HTTPS）をアプリに公開しません。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O DNS transforma nomes como apple.com em endereços IP. Esta verificação só confirma que a consulta funciona na rede atual. O iOS não permite que apps vejam se o DNS está criptografado (iCloud Private Relay ou DNS over HTTPS)."
          }
        }
      }
    },
