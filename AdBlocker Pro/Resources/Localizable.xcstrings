    "A proxy can reroute your traffic through another server. On school or corporate Wi-Fi this is normal. On an unknown network it may mean traffic is being inspected. This check reads system proxy settings only." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un proxy puede redirigir tu tráfico a través de otro servidor. En Wi-Fi escolar o corporativa esto es normal. En una red desconocida puede significar que el tráfico está siendo inspeccionado. Esta comprobación lee solo la configuración de proxy del sistema."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "プロキシは通信を別のサーバー経由で転送できます。学校や会社のWi-Fiでは普通です。未知のネットワークでは通信が検査されている可能性があります。このチェックはシステムのプロキシ設定のみを読み取ります。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Um proxy pode redirecionar seu tráfego por outro servidor. Em Wi-Fi escolar ou corporativa isso é normal. Em uma rede desconhecida, o tráfego pode estar sendo inspecionado. Esta verificação lê apenas as configurações de proxy do sistema."
          }
        }
      }
    },
    "A proxy is configured on this network" : {
      "comment" : "Description of a privacy check when a proxy is configured on the user's network.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hay un proxy configurado en esta red"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このネットワークにはプロキシが設定されています"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Há um proxy configurado nesta rede"
          }
        }
      }
    },
    "A VPN interface (such as utun or ipsec) is active. Your traffic is likely tunneled, which hides it from the local Wi-Fi operator. This app cannot see which VPN provider you use." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hay una interfaz VPN activa (como utun o ipsec). Tu tráfico probablemente va por un túnel, oculto para el operador del Wi-Fi local. Esta app no puede ver qué proveedor de VPN usas."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "VPNインターフェース（utunやipsecなど）が有効です。通信はトンネル化され、ローカルWi-Fi運営者から見えにくくなります。このアプリでは利用中のVPN事業者は確認できません。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uma interface VPN (como utun ou ipsec) está ativa. Seu tráfego provavelmente está em um túnel, oculto do operador do Wi-Fi local. Este app não consegue ver qual provedor de VPN você usa."
          }
        }
      }
    },
